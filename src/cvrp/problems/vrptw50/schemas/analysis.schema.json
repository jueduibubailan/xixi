{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cvrp analysis payload (S1)",
  "type": "object",
  "required": [
    "problem_type",
    "full_name",
    "summary",
    "constraints",
    "state_variables",
    "masking_rules",
    "feasibility_checklist",
    "objective",
    "output_contract",
    "pomo_modification_plan"
  ],
  "additionalProperties": true,
  "properties": {
    "problem_type": { "type": "string", "minLength": 1 },
    "full_name": { "type": "string" },
    "summary": { "type": "string", "minLength": 20 },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "rule"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "rule": { "type": "string", "minLength": 3 }
        }
      }
    },
    "state_variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "shape", "update"],
        "properties": {
          "name": { "type": "string" },
          "shape": { "type": "string" },
          "dtype": { "type": "string" },
          "update": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "masking_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "condition"],
        "properties": {
          "name": { "type": "string" },
          "condition": { "type": "string", "minLength": 3 },
          "tensor": { "type": "string" },
          "shape": { "type": "string" },
          "exception": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "feasibility_checklist": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 5 }
    },
    "objective": { "type": "string", "minLength": 3 },
    "output_contract": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string" }
    },
    "pomo_modification_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "change"],
        "properties": {
          "file": { "type": "string" },
          "symbol": { "type": "string" },
          "change": { "type": "string" },
          "why": { "type": "string" }
        }
      }
    },
    "checkpoint_compatibility": {
      "type": "object",
      "properties": {
        "checkpoint": { "type": "string" },
        "encoder_input_dim_must_stay": { "type": "integer" },
        "strategy": { "type": "string" },
        "risk": { "type": "string" }
      }
    },
    "run_plan": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
