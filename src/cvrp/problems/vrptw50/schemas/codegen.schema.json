{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cvrp code generation payload (S2/S4)",
  "type": "object",
  "required": ["status", "summary", "files"],
  "additionalProperties": true,
  "properties": {
    "status": { "type": "string", "enum": ["ok", "failed"] },
    "summary": { "type": "string" },
    "files": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "checkpoint_keys_skipped": { "type": "array", "items": { "type": "string" } },
    "masking_implemented": { "type": "array", "items": { "type": "string" } },
    "not_implemented": { "type": "array", "items": { "type": "string" } }
  }
}
